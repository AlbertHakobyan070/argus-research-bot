# Argus — .env template (Windows, macOS, Linux). Copy to .env and fill in.
# .env is gitignored; never commit it. Placeholders only below.
# Defaults live in the code (src/argus/config.py, argus_engines.json); a
# commented line keeps its default.
# Comments always sit on their own line: python-dotenv reads
# "KEY=   # text" as the value "# text" when the value is blank.

# ---------------------------------------------------------------------
# Telegram (required)
# ---------------------------------------------------------------------
# <id>:<secret> from @BotFather
TELEGRAM_BOT_TOKEN=
# your numeric Telegram user id (the bot answers only this user)
TELEGRAM_ALLOWED_USER_ID=

# ---------------------------------------------------------------------
# Engines (argus_engines.json names these variables; a key is needed only
# when the active profile binds that provider as a primary — see /engines)
# ---------------------------------------------------------------------
# the local FreeLLMAPI proxy (default profile); this is also the code default
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
# freellmapi-… from the proxy dashboard's Keys page
FREELLMAPI_API_KEY=
# GROQ_API_KEY is also the default openai_audio transcriber provider
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# The engines files; relative paths are taken from the repo root.
# ARGUS_ENGINES_FILE=argus_engines.json
# Optional, gitignored overrides:
# ARGUS_ENGINES_LOCAL_FILE=argus_engines.local.json

# ---------------------------------------------------------------------
# Search (optional)
# ---------------------------------------------------------------------
# https://dashboard.exa.ai — enables Exa search; leave blank to skip. The
# per-run budget comes from the depth preset (run_config), not from env.
EXA_API_KEY=

# ---------------------------------------------------------------------
# Mini App console (optional; the bot runs without it)
# ---------------------------------------------------------------------
# ARGUS_WEBAPP_ENABLED=true
# The console listens on 127.0.0.1:<port>:
# ARGUS_WEBAPP_PORT=
# quick (cloudflared quick tunnel) | none (local only):
# ARGUS_WEBAPP_TUNNEL=quick
# The cloudflared binary; default tools/bin/cloudflared(.exe). The run-script
# pre-flight stops it only when it runs the bot's own tunnel command line
# (see handoff.md, Running day to day):
# ARGUS_CLOUDFLARED=
# An HTTPS URL you run yourself; replaces the tunnel:
# ARGUS_WEBAPP_PUBLIC_URL=
# How old a console session may get, seconds:
# ARGUS_WEBAPP_INITDATA_MAX_AGE_S=

# ---------------------------------------------------------------------
# Run driver (optional)
# ---------------------------------------------------------------------
# How long a cancel waits for the current step before task.cancel(), seconds:
# ARGUS_CANCEL_DRAIN_TIMEOUT_S=
# Bound on draining live runs at shutdown, seconds:
# ARGUS_SHUTDOWN_DRAIN_S=

# ---------------------------------------------------------------------
# Storage — where downloads and reports land
# ---------------------------------------------------------------------
# Everything Argus produces lives under this one root:
#   <root>/media/{youtube,x,reddit,instagram}/   downloaded videos
#   <root>/transcripts/                          caption + speech-to-text text
#   <root>/research history/                     reports (md + pdf + evidence.json)
# A leading ~ is expanded to your home directory (macOS/Linux:
# e.g. ~/Argus/vault). Argus creates the subfolders on first use.
# ARGUS_VAULT_ROOT=
# Reports only; default <root>/research history:
# ARGUS_REPORTS_ROOT=
# Databases default to the repo root; keep them out of a synced folder
# (iCloud/Dropbox/OneDrive) — SQLite and file sync corrupt each other.
# ARGUS_LIBRARY_DB=
# ARGUS_CHECKPOINT_DB=

# ---------------------------------------------------------------------
# Media downloader (optional)
# ---------------------------------------------------------------------
# ffmpeg merges separate video+audio streams. Unset, Argus uses the
# imageio-ffmpeg binary pip installs (works on Windows and macOS).
# ARGUS_FFMPEG=
# Parallel HLS fragment downloads; lower it on a saturated link:
# ARGUS_MEDIA_FRAGMENTS=
# Simultaneous downloads:
# ARGUS_MEDIA_CONCURRENCY=
# Kill a download after this many seconds of silence:
# ARGUS_MEDIA_STALL_TIMEOUT=
# Absolute ceiling per download, seconds:
# ARGUS_MEDIA_TIMEOUT=
# Login-walled or age-gated posts (private X video, Instagram, restricted
# YouTube). Pick ONE. Quit the browser first — Chrome locks its cookie DB.
# A browser name: chrome | firefox | safari (macOS) | …
# ARGUS_YTDLP_COOKIES_BROWSER=
# Or a cookies.txt file:
# ARGUS_YTDLP_COOKIES=

# ---------------------------------------------------------------------
# intel-stack (optional; research works without it)
# ---------------------------------------------------------------------
# Both set → adds the intel_* fetch rungs:
# INTEL_STACK_DIR=
# INTEL_PYTHON=
# Per intel-stack subprocess, seconds:
# ARGUS_TOOL_TIMEOUT=

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
# ARGUS_LOG=INFO
# httpx logs every HTTP request at INFO, Telegram's included; the bot token is
# always redacted from log lines, whatever this says. false stops those
# httpx/httpcore request lines; warnings and errors still show:
# ARGUS_LOG_HTTP=true

# ---------------------------------------------------------------------
# Removed — no longer read. Each one still set logs one startup WARNING
# naming its replacement (the list: REMOVED_ENV_KNOBS in
# src/argus/engines/registry.py):
#   ARGUS_TIMEOUT, ARGUS_LLM_RETRIES       → ProviderSpec.timeout_s / the LLM facade's retry policy
#   ARGUS_RESEARCH_WAVES, ARGUS_FETCH_PER_WAVE, ARGUS_TOTAL_FETCH_CAP,
#   ARGUS_EXA_MAX_CALLS, ARGUS_MAX_REVISIONS,
#   ARGUS_FETCH_CONCURRENCY, ARGUS_DIGEST_CONCURRENCY,
#   ARGUS_COMPOSE_CONCURRENCY              → the depth preset / run_config knobs
#   ARGUS_WHISPER_MODEL                    → argus_engines.json transcriber.faster_whisper.model
#   PERPLEXITY_API_KEY                     → nothing (Perplexity search was removed)
# ---------------------------------------------------------------------
