# Argus — .env template (Windows, macOS, Linux). Copy to .env and fill in.
# .env is gitignored; never commit it. Placeholders only below.
# Defaults live in the code (src/argus/config.py, argus_engines.json); a
# commented line keeps its default.

# ---------------------------------------------------------------------
# Telegram (required)
# ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=                      # <id>:<secret> from @BotFather
TELEGRAM_ALLOWED_USER_ID=                # your numeric Telegram user id (the bot answers only this user)

# ---------------------------------------------------------------------
# Engines (argus_engines.json names these variables; a key is needed only
# when the active profile binds that provider as a primary — see /engines)
# ---------------------------------------------------------------------
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1     # the local FreeLLMAPI proxy (default profile); also the code default
FREELLMAPI_API_KEY=                      # freellmapi-… from the proxy dashboard's Keys page
# GROQ_API_KEY=                          # also the default openai_audio transcriber provider
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ARGUS_ENGINES_FILE=argus_engines.json              # relative paths are taken from the repo root
# ARGUS_ENGINES_LOCAL_FILE=argus_engines.local.json  # optional, gitignored overrides

# ---------------------------------------------------------------------
# Search (optional)
# ---------------------------------------------------------------------
EXA_API_KEY=                             # https://dashboard.exa.ai — enables Exa search; the per-run
                                         # budget comes from the depth preset (run_config), not from env

# ---------------------------------------------------------------------
# Mini App console (optional; the bot runs without it)
# ---------------------------------------------------------------------
# ARGUS_WEBAPP_ENABLED=true
# ARGUS_WEBAPP_PORT=                     # the console listens on 127.0.0.1:<port>
# ARGUS_WEBAPP_TUNNEL=quick              # quick (cloudflared quick tunnel) | none (local only)
# ARGUS_CLOUDFLARED=                     # cloudflared binary; default tools/bin/cloudflared(.exe)
# ARGUS_WEBAPP_PUBLIC_URL=               # an HTTPS URL you run yourself; replaces the tunnel
# ARGUS_WEBAPP_INITDATA_MAX_AGE_S=       # how old a console session may get

# ---------------------------------------------------------------------
# Run driver (optional)
# ---------------------------------------------------------------------
# ARGUS_CANCEL_DRAIN_TIMEOUT_S=          # how long a cancel waits for the current step before task.cancel()
# ARGUS_SHUTDOWN_DRAIN_S=                # bound on draining live runs at shutdown

# ---------------------------------------------------------------------
# Storage — where downloads and reports land
# ---------------------------------------------------------------------
# Everything Argus produces lives under this one root:
#   <root>/media/{youtube,x,reddit,instagram}/   downloaded videos
#   <root>/transcripts/                          caption + speech-to-text text
#   <root>/research history/                     reports (md + pdf + evidence.json)
# A leading ~ is expanded to your home directory (macOS/Linux:
# e.g. ~/Argus/vault). Argus creates the subfolders on first use.
# ARGUS_VAULT_ROOT=
# ARGUS_REPORTS_ROOT=                    # reports only; default <root>/research history
# Databases default to the repo root; keep them out of a synced folder
# (iCloud/Dropbox/OneDrive) — SQLite and file sync corrupt each other.
# ARGUS_LIBRARY_DB=
# ARGUS_CHECKPOINT_DB=

# ---------------------------------------------------------------------
# Media downloader (optional)
# ---------------------------------------------------------------------
# ffmpeg merges separate video+audio streams. Unset, Argus uses the
# imageio-ffmpeg binary pip installs (works on Windows and macOS).
# ARGUS_FFMPEG=
# ARGUS_MEDIA_FRAGMENTS=                 # parallel HLS fragment downloads; lower it on a saturated link
# ARGUS_MEDIA_CONCURRENCY=               # simultaneous downloads
# ARGUS_MEDIA_STALL_TIMEOUT=             # kill a download after this many seconds of silence
# ARGUS_MEDIA_TIMEOUT=                   # absolute ceiling per download, seconds
# Login-walled or age-gated posts (private X video, Instagram, restricted
# YouTube). Pick ONE. Quit the browser first — Chrome locks its cookie DB.
# ARGUS_YTDLP_COOKIES_BROWSER=           # chrome | firefox | safari (macOS) …
# ARGUS_YTDLP_COOKIES=                   # a cookies.txt file

# ---------------------------------------------------------------------
# intel-stack (optional; research works without it)
# ---------------------------------------------------------------------
# INTEL_STACK_DIR=                       # with INTEL_PYTHON, adds the intel_* fetch rungs
# INTEL_PYTHON=
# ARGUS_TOOL_TIMEOUT=                    # per intel-stack subprocess, seconds

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
# ARGUS_LOG=INFO

# ---------------------------------------------------------------------
# Removed — no longer read. Each one still set logs one startup WARNING
# naming its replacement (the list: REMOVED_ENV_KNOBS in
# src/argus/engines/registry.py):
#   ARGUS_TIMEOUT, ARGUS_LLM_RETRIES       → ProviderSpec.timeout_s / the LLM facade's retry policy
#   ARGUS_RESEARCH_WAVES, ARGUS_FETCH_PER_WAVE, ARGUS_TOTAL_FETCH_CAP,
#   ARGUS_EXA_MAX_CALLS, ARGUS_MAX_REVISIONS,
#   ARGUS_FETCH_CONCURRENCY, ARGUS_DIGEST_CONCURRENCY,
#   ARGUS_COMPOSE_CONCURRENCY              → the depth preset / run_config knobs
#   ARGUS_WHISPER_MODEL                    → argus_engines.json transcriber.faster_whisper.model
#   PERPLEXITY_API_KEY                     → nothing (Perplexity search was removed)
# ---------------------------------------------------------------------
