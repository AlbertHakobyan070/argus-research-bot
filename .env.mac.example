# Argus — macOS .env template. Copy to .env and fill in the secrets.
# The five secrets below are NOT in the transfer archive on purpose;
# copy them from the Windows machine's .env (see handoff.md, step 3).

# ---------------------------------------------------------------------
# Secrets — copy these five values verbatim from the Windows .env
# ---------------------------------------------------------------------
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=                      # freellmapi-...
TELEGRAM_BOT_TOKEN=                      # <id>:<secret> from @BotFather
TELEGRAM_ALLOWED_USER_ID=                # your numeric Telegram user id
EXA_API_KEY=                             # https://dashboard.exa.ai

# ---------------------------------------------------------------------
# Storage — THIS is where downloads land on the Mac
# ---------------------------------------------------------------------
# Everything Argus produces lives under this one root:
#   <root>/media/{youtube,x,reddit,instagram}/   downloaded videos
#   <root>/transcripts/                          whisper + caption text
#   <root>/research history/                     reports (md + pdf)
#
# A leading ~ is expanded to your home directory. The path below mirrors
# the Windows layout so a copied vault drops straight in; if you are NOT
# copying the old vault, something like ~/Argus/vault is fine — Argus
# creates the subfolders on first use.
ARGUS_VAULT_ROOT=~/DS_Vault/DS Main Vault/DS_AUA_Toolkit/Assets/Argus

# Databases. Default to the repo root; keep them out of a synced folder
# (iCloud/Dropbox) — SQLite and file sync corrupt each other.
# ARGUS_LIBRARY_DB=~/argus/argus_library.sqlite
# ARGUS_CHECKPOINT_DB=~/argus/argus_checkpoints.sqlite

# ---------------------------------------------------------------------
# Media downloader
# ---------------------------------------------------------------------
# ffmpeg is required to merge separate video+audio streams. Left unset,
# Argus uses the imageio-ffmpeg binary that pip installs — that already
# works on macOS, so you only need this if you prefer Homebrew's:
# ARGUS_FFMPEG=/opt/homebrew/bin/ffmpeg

# Parallel fragment downloads. 8 is ~4.5x faster than serial on X/Twitter
# HLS video; lower it if your connection is saturated.
# ARGUS_MEDIA_FRAGMENTS=8
# ARGUS_MEDIA_CONCURRENCY=2              # simultaneous downloads
# ARGUS_MEDIA_STALL_TIMEOUT=300          # kill after N seconds of silence
# ARGUS_MEDIA_TIMEOUT=5400               # absolute ceiling per download

# Login-walled or age-gated posts (private X video, Instagram, restricted
# YouTube). Pick ONE. Cookies-from-browser needs the browser installed;
# on macOS Safari also works. Quit the browser first — Chrome locks its
# cookie DB while running.
# ARGUS_YTDLP_COOKIES_BROWSER=chrome
# ARGUS_YTDLP_COOKIES=~/argus-cookies.txt

# ---------------------------------------------------------------------
# Research engine (optional tuning)
# ---------------------------------------------------------------------
# ARGUS_EXA_MAX_CALLS=6
# ARGUS_RESEARCH_WAVES=2
# ARGUS_TOTAL_FETCH_CAP=28
