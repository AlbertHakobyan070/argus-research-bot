{
  "version": 1,
  "active_profile": "free-proxy",
  "providers": {
    "freellmapi": {
      "name": "freellmapi",
      "base_url": "http://127.0.0.1:3001/v1",
      "base_url_env": "FREELLMAPI_BASE_URL",
      "api_key_env": "FREELLMAPI_API_KEY",
      "supports_json_mode": false,
      "token_param": "max_tokens",
      "min_max_tokens": 2048,
      "quota_wait_s": 120,
      "timeout_s": 180,
      "models_endpoint": true,
      "model_preferences": {
        "cheap": ["auto"],
        "strong": ["auto"],
        "judge": ["auto"]
      },
      "rpm_limit": 100,
      "notes": "local FreeLLMAPI proxy; every tier asks for 'auto': since v0.16 a named model pins routing to that one model (no failover), so a named free model jams on its own daily cap. Each call records the served model and routed_via"
    },
    "groq": {
      "name": "groq",
      "base_url": "https://api.groq.com/openai/v1",
      "api_key_env": "GROQ_API_KEY",
      "supports_json_mode": true,
      "rpm_limit": 25,
      "notes": "reasoning controls go into EngineSpec.extra_body only after engines_probe.py confirms the API accepts them"
    },
    "openrouter": {
      "name": "openrouter",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "headers": {
        "HTTP-Referer": "https://github.com/AlbertHakobyan070/argus-research-bot",
        "X-Title": "Argus"
      }
    },
    "gemini": {
      "name": "gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "api_key_env": "GEMINI_API_KEY",
      "notes": "beta compatibility layer"
    },
    "openai": {
      "name": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "supports_json_mode": true,
      "token_param": "max_completion_tokens",
      "timeout_s": 300
    },
    "anthropic": {
      "name": "anthropic",
      "base_url": "https://api.anthropic.com/v1/",
      "api_key_env": "ANTHROPIC_API_KEY",
      "models_endpoint": false,
      "known_models": [
        "claude-fable-5-1",
        "claude-opus-5-5",
        "claude-sonnet-5-5",
        "claude-haiku-5-5"
      ],
      "supports_temperature": false,
      "supports_json_mode": false,
      "timeout_s": 300,
      "notes": "OpenAI-compatible layer, positioned for testing and comparison: temperature/top_p are omitted (400 on Claude 4.7+/5), response_format is ignored, system messages are hoisted, n must be 1, no prompt caching; thinking is on by default and not returned, so budget it per role via EngineSpec.extra_body {\"thinking\": ...}"
    },
    "ollama": {
      "name": "ollama",
      "base_url": "http://127.0.0.1:11434/v1",
      "supports_json_mode": true
    },
    "lmstudio": {
      "name": "lmstudio",
      "base_url": "http://127.0.0.1:1234/v1"
    }
  },
